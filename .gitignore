# ─── PokiInk-specific (excluded from release repo) ──────────────────────────
# Reference firmware archives — kept on the build machine but not in the
# public repo (the binaries are sensitive third-party redistributions and
# would balloon clone size for no benefit to contributors).
codex_backups/
backups/
firmware-output/
build-output/
Halo_2_firmware/
Released Halo 2 UI firmware/

# Python virtual environments for one-off scripting tools.  Each contributor
# rebuilds them locally — see scripts/ docs for the package list.
.venv-zwsp/
.venv-fonttools/

# Per-machine AI assistant scratch state.
.claude/
.skills/
*.session-backup*

# Test data with potential copyright issues — contributors can drop their
# own books into simulator/sd_data/books/ locally.
simulator/sd_data/books/*.epub
simulator/sd_data/books/*.txt
simulator/sd_data/books/*.pdf

# Large font-source archives — rebuilt on demand from upstream Google Fonts.
# Building fonts is a tools/font-builder pre-release step, not something a
# normal contributor needs to do.
lib/EpdFont/builtinFonts/source/*/[0-9]*.zip
